---
import Layout from '@layouts/Chrome.astro';

const props = Astro.props;
---

<Layout {...props}>
  <main id="main" class="dark:bg-primary-950 flex min-h-0 w-full flex-1 self-center text-zinc-700">
    <section class="flex min-h-0 flex-1 flex-col">
      <slot name="crumbs" />
      <div class="px-6">
        <slot name="quick-links" />
      </div>
      <slot />
    </section>
  </main>
</Layout>
