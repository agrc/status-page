---
import Banner from '@components/layout/Banner.astro';
import BaseHead from '@components/layout/BaseHead.astro';
import SocialMedia from '@components/SocialMedia.astro';
import UtahChrome from '@components/UtahChrome.astro';

import '@utahdts/utah-design-system-header/css';
import '../styles/tailwind.css';

const { pageTitle = 'UGRC', bannerHeading, image } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="UGRC System Status"
      description="The UGRC system status page has the most up to date information on issues with UGRC products. If there is an outage you can read about it here."
      image={image}
    />
  </head>
  <body class="dark:bg-primary-950 bg-white">
    <div class="flex flex-col">
      <div id="utah-header-placeholder"></div>
      <UtahChrome />
      <Banner title={bannerHeading || pageTitle} />
      <main id="main-content" class="flex min-h-0 flex-1 flex-col">
        <slot />
      </main>
    </div>
    <footer>
      <SocialMedia />
      <div id="utah-footer-placeholder"></div>
    </footer>
  </body>
</html>
