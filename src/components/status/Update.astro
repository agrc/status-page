---
type Props = {
  date: Date;
};

const { date } = Astro.props;
const updated = new Date(date);
---

<p>
  <span class="text-primary-100 dark:text-accent-100 font-bold">
    <time datetime={updated.toISOString()} data-local-format="date-time">{updated.toISOString()}</time>
  </span>
</p>
<div>
  <slot />
</div>
